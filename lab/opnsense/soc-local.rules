alert ip [203.0.113.66] any -> $HOME_NET any (msg:"SOC ER1 acces depuis IP IOC"; threshold:type limit, track by_src, count 1, seconds 60; classtype:bad-unknown; sid:1000010; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC ER3 transfert fichier EICAR"; flow:established,to_client; file_data; content:"EICAR-STANDARD-ANTIVIRUS-TEST-FILE"; classtype:trojan-activity; sid:1000030; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"SOC ER4 scan de ports"; flags:S,12; threshold:type both, track by_src, count 30, seconds 10; classtype:attempted-recon; sid:1000040; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"SOC ER5 SYN flood"; flags:S,12; threshold:type both, track by_src, count 500, seconds 5; classtype:attempted-dos; sid:1000050; rev:1;)
alert icmp any any -> 192.168.56.2 any (msg:"SOC TEST ping vers le WAN OPNsense"; itype:8; threshold:type limit, track by_src, count 1, seconds 60; classtype:misc-activity; sid:1000090; rev:1;)
